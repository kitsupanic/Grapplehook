{
  "name": "grapplehook",
  "private": true,
  "type": "module",
  "description": "Download and transcode videos with yt-dlp and ffmpeg.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier . --write",
    "lint": "eslint . && prettier . --check",
