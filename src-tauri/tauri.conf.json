{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grapplehook",
  "identifier": "dev.grapplehook",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grapplehook",
        "width": 760,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "backgroundColor": "#14171c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "license": "MIT",
    "targets": ["dmg", "nsis", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
